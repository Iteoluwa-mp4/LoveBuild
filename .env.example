# Copy to `.env.local` and fill in. Never commit it.
#
# Sites live in Neon Postgres when Firebase is configured, behind the API in
# `server/`. With no file at all, `npm run dev` still works in local open mode with
# sites in this browser's localStorage — that is the development path, not a
# second product.

# Firebase Authentication.
#
# These are public identifiers, not secrets. The web API key ships inside the
# bundle — that is how Firebase is designed — and the project is protected by
# authorized domains and (later) App Check. Do not treat it as a password or try
# to hide it behind a server.
#
# Leave all four empty and `npm run dev` stays in local mode with no login
# screen. That is the development behaviour. A production build without them
# fails closed to the login screen with a configuration message; a shared
# deployment needs them.
#
# Firebase Console -> Project settings -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase project id, used by the API to verify ID tokens against
# Google's public keys. It is the same value as VITE_FIREBASE_PROJECT_ID; the
# API falls back to that variable when this one is absent. Add it explicitly in
# the host's environment settings so the server does not depend on a browser
# variable's name.
FIREBASE_PROJECT_ID=

# Cloudinary. The cloud name is public: it appears in every upload URL and in the
# delivered image URLs, so anyone loading the page can see it. That is fine, and
# it is why the variable has a VITE_ prefix.
VITE_CLOUDINARY_CLOUD_NAME=

# The preset the browser uploads to, unsigned.
#
# An unsigned preset is what lets uploads work with no server at all — the
# browser POSTs the file and this name, and Cloudinary accepts it. The cost is
# that the name is public (it is compiled into the bundle, necessarily), so
# anyone who learns it can upload into this account. Lock the preset down in
# Cloudinary: pin a target folder, allow only the formats the dashboard accepts
# (image/* and video/*), and set a max file size.
#
# When a backend exists to sign uploads, delete this and sign with
# CLOUDINARY_API_KEY + CLOUDINARY_API_SECRET instead — then this preset stops
# accepting anything that is not signed.
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server-side only. Anything prefixed VITE_ is compiled into the bundle and is
# readable by anyone who loads the page, so the API secret must never carry that
# prefix. It is read by whatever signs uploads — currently nothing, until uploads
# are signed.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Neon Postgres.
#
# Server-side only. Never add a VITE_ prefix: Vite inlines VITE_ variables into
# the browser bundle, and a Postgres credential in the browser would let anyone
# read or write the database.
#
# `neon link` (or `neon env pull`) writes these into `.env.local`. Use the pooled
# URL at runtime for serverless API routes, and the direct URL for migrations and
# scripts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional. The local API server's port; Vite proxies `/api` to it. Defaults to
# 8787.
API_PORT=
