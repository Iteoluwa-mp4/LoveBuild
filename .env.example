# Copy to `.env` and fill in. Never commit `.env`.
#
# The anon key is public — it ships inside the bundle. Everything it can reach
# is gated by row level security, not by this key. Losing RLS means losing the
# data, so check the policies before you ever load this in a browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary. The API secret must NEVER be prefixed with VITE_ — anything with
# that prefix is bundled and readable. Signing happens in a Supabase Edge
# Function instead.
VITE_CLOUDINARY_CLOUD_NAME=

# Server-side only, read by the Edge Function. No VITE_ prefix.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=