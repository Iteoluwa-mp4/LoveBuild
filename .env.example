# Copy to `.env.local` and fill in. Never commit it.
#
# There is deliberately almost nothing here. Sites are stored in this browser,
# so the app works with no file at all — which is the normal case, not a fallback.

# Cloudinary. The cloud name is public: it appears in every upload URL and in the
# delivered image URLs, so anyone loading the page can see it. That is fine, and
# it is why the variable has a VITE_ prefix.
VITE_CLOUDINARY_CLOUD_NAME=

# Server-side only. Anything prefixed VITE_ is compiled into the bundle and is
# readable by anyone who loads the page, so the API secret must never carry that
# prefix. It is read by whatever signs uploads — currently nothing, until a
# backend exists to hold it.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=