# Copy to `.env.local` and fill in. Never commit it.
#
# There is deliberately almost nothing here. Sites are stored in this browser,
# so the app works with no file at all — which is the normal case, not a fallback.

# Firebase Authentication.
#
# These are public identifiers, not secrets. The web API key ships inside the
# bundle — that is how Firebase is designed — and the project is protected by
# authorized domains, security rules and (later) App Check. Do not treat it as
# a password or try to hide it behind a server.
#
# Leave all four empty and the app stays in local mode with no login screen.
# That is the development behaviour; a shared deployment needs them.
#
# With these set, sites are stored in Firestore under this project. Create the
# database and publish `firestore.rules` before the first save; see README
# § "Firestore setup".
#
# Firebase Console -> Project settings -> Your apps -> SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary. The cloud name is public: it appears in every upload URL and in the
# delivered image URLs, so anyone loading the page can see it. That is fine, and
# it is why the variable has a VITE_ prefix.
VITE_CLOUDINARY_CLOUD_NAME=

# The preset the browser uploads to, unsigned.
#
# An unsigned preset is what lets uploads work with no server at all — the
# browser POSTs the file and this name, and Cloudinary accepts it. The cost is
# that the name is public (it is compiled into the bundle, necessarily), so
# anyone who learns it can upload into this account. Lock the preset down in
# Cloudinary: pin a target folder, allow only the formats the dashboard accepts
# (image/* and video/*), and set a max file size.
#
# When a backend exists to sign uploads, delete this and sign with
# CLOUDINARY_API_KEY + CLOUDINARY_API_SECRET instead — then this preset stops
# accepting anything that is not signed.
VITE_CLOUDINARY_UPLOAD_PRESET=

# Server-side only. Anything prefixed VITE_ is compiled into the bundle and is
# readable by anyone who loads the page, so the API secret must never carry that
# prefix. It is read by whatever signs uploads — currently nothing, until a
# backend exists to hold it.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=